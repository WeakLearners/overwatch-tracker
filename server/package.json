{
  "name": "server",
  "version": "1.0.0",
  "scripts": {
    "dev": "PORT=3002 tsx watch --experimental-sqlite src/index.ts",
    "start": "tsx --experimental-sqlite src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --experimental-sqlite --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "test:summary": "bash ../scripts/test-summary.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  }
}
