ANTHROPIC_API_KEY=your-key-here

# Comma-separated list of allowed CORS origins for the client. Defaults to
# http://localhost:5173 if unset.
ALLOWED_ORIGINS=http://localhost:5173

# Scoreboard screenshot folder (Drive for desktop). Unset = the watcher stays off.
# SCOREBOARD_DIR=/path/to/OW Game Logs
# SCOREBOARD_READER=cli   # cli (default, Claude plan via `claude -p`) or api (Anthropic API credit)
# CLAUDE_BIN=/Users/Sean/.local/bin/claude   # optional absolute path for the cli reader
